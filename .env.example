# 轻聊后端环境变量配置
# 复制为 .env 并填入实际值

# === 数据目录 ===
# 后端数据根目录（存储聊天记录、知识库等）
QL_DATA_DIR=/data
# 上传文件目录
QL_UPLOAD_DIR=/data/uploads
# Hermes 数据目录（容器视角）
QL_HERMES_DATA_DIR=/data/hermes
# Hermes 宿主目录（容器挂载点）
QL_HERMES_HOST_DIR=/data/hermes_host
# Hermes 宿主根目录
QL_HERMES_ROOT_DIR=/data/hermes

# === 目录路径 ===
# ASR 临时目录
QL_ASR_DIR=/data/asr_tmp
# ASR 临时目录（宿主视角）
QL_ASR_DIR_HOST=/data/asr_tmp
# 知识库目录
QL_KB_DIR=/data/kb
# 日志目录
QL_LOGS_DIR=/data/logs
# 记忆存储路径
QL_MEMORY_PATH=/data/memory.json
# 密钥存储路径
QL_SECRETS_STORE=/data/secrets_store.json.enc
# 密钥文件路径
QL_SECRETS_KEY=/data/.secrets_key

# === 配置文件 ===
# 主配置文件路径
QL_CONFIG_YAML=/data/profiles/wechat-profile/config.yaml
# 备用配置文件路径
QL_CONFIG_YAML_FALLBACK=/data/profiles/wechat-profile/config.yaml

# === 工具路径 ===
# Whisper Python 解释器路径
QL_WHISPER_PYTHON=/usr/local/bin/python3
# ASR 服务器脚本路径
QL_ASR_SERVER=/app/asr_server.py

# === 容器配置 ===
# Hermes 容器名称
QL_HERMES_CONTAINER=hermes-container

# === 网络配置 ===
# Stream webhook URL
STREAM_WEBHOOK_URL=http://localhost:8644/webhooks/qingliao-push
# Ollama API URL
QL_OLLAMA_URL=http://localhost:11434/v1

# === 认证 ===
# 管理员密码
QL_PASSWORD=changeme

# === 端口 ===
# 主 API 端口
QL_PORT=9140
# Stream API 端口
QL_STREAM_PORT=9142
# ASR API 端口
QL_ASR_PORT=9143
# Push API 端口
QL_PUSH_PORT=9147
# Local API 端口
QL_LOCAL_PORT=9149
